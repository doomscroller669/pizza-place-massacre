  "cfg": 0.5,
  "fx": null,
  "take": "f5c78376-7e4031e5.mp3"
 },
 {
  "key": "c8b275e3",
  "who": "manny",
  "text": "A pizza with eight slices. Eight digits. I don’t know any of them.",
