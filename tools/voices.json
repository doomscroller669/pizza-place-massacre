  "cfg": 0.35,
  "fx": "shaky",
  "take": "402d96f9-cc7bf783.mp3"
 },
 {
  "key": "bb36c2da",
  "who": "manny",
  "text": "\"Toni’s Famous Seeds.\" It’s sesame. We put it on everything.",
