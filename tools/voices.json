  "cfg": 0.45,
  "fx": null,
  "take": "4289f36b-331a3d31.mp3"
 },
 {
  "key": "c648a31e",
  "who": "manny",
  "text": "Two bucks a try. Nobody’s ever won a thing out of that.",
  "exaggeration": 0.7,
  "cfg": 0.45,
  "fx": null,
  "take": "c648a31e-a563c9c9.mp3"
 },
 {
  "key": "6b025e33",
  "who": "manny",
  "text": "The spare Toni head. I had to wear that thing at birthday parties. The kids used to cry.",
  "exaggeration": 0.7,
  "cfg": 0.45,
  "fx": null,
  "take": "6b025e33-805753a2.mp3"
 },
 {
  "key": "b84f3d7f",
  "who": "manny",
  "text": "Kiddie Pie. Like the menu. Okay. I can do this.",
  "exaggeration": 0.75,
  "cfg": 0.42,
  "fx": null,
  "take": "b84f3d7f-74b96060.mp3"
 },
 {
  "key": "81bd9398",
  "who": "manny",
  "text": "He… forgives me? Okay. Okay. Breathe.",
