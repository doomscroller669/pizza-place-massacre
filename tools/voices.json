  "cfg": 0.5,
  "fx": null,
  "take": "c8b275e3-7e4031e5.mp3"
 },
 {
  "key": "19528e5b",
  "who": "manny",
  "text": "Locked. And the grate’s down outside. His car’s still in the lot.",
