  "cfg": 0.4,
  "fx": "shaky",
  "take": "69c665d9-68cbae8b.mp3"
 },
 {
  "key": "11147a58",
  "who": "dad",
  "text": "Okay! Okay. Just… eat around them, mijo. Eat around them.",
  "exaggeration": 1.3,
  "cfg": 0.3,
  "fx": "shaky",
  "take": "11147a58-174ce273.mp3"
 },
 {
  "key": "bd8759a4",
  "who": "dad",
  "text": "Lucia, don’t. Don’t give him a reason.",
  "exaggeration": 0.85,
  "cfg": 0.4,
  "fx": null,
  "take": "bd8759a4-f01e4da6.mp3"
 },
 {
  "key": "919406ea",
  "who": "dad",
  "text": "Okay. Okay, mijo. You’re okay.",
  "exaggeration": 0.95,
  "cfg": 0.35,
  "fx": "shaky",
  "take": "919406ea-c49d4692.mp3"
 },
 {
  "key": "bad62292",
  "who": "dad",
  "text": "ALEX! His pen—his pen’s in his jacket! LET ME—",
