  "fx": null,
  "take": "7429d4c4-ecb03ccb.mp3"
 },
 {
  "key": "35e6594a",
  "who": "manny",
  "text": "Still in the walk-in. I can’t feel my fingers anymore.",
  "exaggeration": 0.75,
  "cfg": 0.4,
  "fx": null,
  "take": "35e6594a-acff4147.mp3"
 },
 {
  "key": "d3082114",
  "who": "manny",
  "text": "It’s open. Okay. Do what he says, and you go home.",
  "exaggeration": 0.85,
  "cfg": 0.38,
  "fx": null,
  "take": "d3082114-b094dd93.mp3"
 },
