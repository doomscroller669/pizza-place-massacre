  "cfg": 0.45,
  "fx": null,
  "take": "94953072-8dafdd75.mp3"
 },
 {
  "key": "f8c1b814",
  "who": "manny",
  "text": "Locked. The grate’s down outside. And his car’s still in the lot. He’s not going anywhere.",
