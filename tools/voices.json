  "cfg": 0.5,
  "fx": null,
  "take": "db5061ca-7e4031e5.mp3"
 },
 {
  "key": "2fdad862",
  "who": "manny",
  "text": "The spare Toni head. The eyes are felt pepperoni. I always hated wearing it.",
