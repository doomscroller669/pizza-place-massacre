[
 {
  "key": "b15db62d",
  "who": "lucia",
  "text": "Dad... what do we do?",
  "exaggeration": 0.75,
  "cfg": 0.4,
  "fx": null,
  "take": "b15db62d-2d6ec312.mp3"
 },
 {
  "key": "738dfa56",
  "who": "dad",
  "text": "We stay calm. We do what he says. I’m getting you two out of here, mija.",
  "exaggeration": 0.6,
  "cfg": 0.45,
  "fx": "shaky",
  "take": "738dfa56-853af3f3.mp3"
 },
 {
  "key": "72814a62",
  "who": "dad",
  "text": "Lucia? ...Lucia!",
  "exaggeration": 1.15,
  "cfg": 0.3,
  "fx": null,
  "take": "72814a62-b48e5b49.mp3"
 },
 {
  "key": "96ef3529",
  "who": "alex",
  "text": "Dad? Where are we?",
  "exaggeration": 1.0,
  "cfg": 0.35,
  "fx": "shaky",
  "take": "96ef3529-c1e4a9ec.mp3"
 },
 {
  "key": "94b23273",
  "who": "grandpa",
  "text": "What the hell is this?",
  "exaggeration": 1.0,
  "cfg": 0.35,
  "fx": null,
  "take": "94b23273-fa567d74.mp3"
 },
 {
  "key": "9e6379bd",
  "who": "uncle",
  "text": "Hey! HEY! Who’s out there?",
  "exaggeration": 1.5,
  "cfg": 0.3,
  "fx": "shout",
  "take": "9e6379bd-ff54f145.mp3"
 },
 {
  "key": "577c6841",
  "who": "ruben",
  "text": "This is a party room. Why are we in a party room?",
  "exaggeration": 1.1,
  "cfg": 0.35,
  "fx": null,
  "take": "577c6841-5ee0a4d9.mp3"
 },
 {
  "key": "40f24f7c",
  "who": "dad",
  "text": "That’s it. We’re leaving—",
  "exaggeration": 1.2,
  "cfg": 0.35,
  "fx": "shout",
  "take": "40f24f7c-c9f71824.mp3"
 },
 {
  "key": "70faa4e2",
  "who": "lucia",
  "text": "There’s a pizza box in the middle of the table. With wires.",
  "exaggeration": 0.65,
  "cfg": 0.4,
  "fx": null,
  "take": "70faa4e2-5237622b.mp3"
 },
 {
  "key": "23663206",
  "who": "uncle",
  "text": "Twelve pizzas? Is this a joke?",
  "exaggeration": 1.0,
  "cfg": 0.35,
  "fx": null,
  "take": "23663206-930e894f.mp3"
 },
 {
  "key": "16539ac5",
  "who": "ruben",
  "text": "That’s… that’s the mascot. From the sign.",
  "exaggeration": 0.9,
  "cfg": 0.35,
  "fx": "shaky",
  "take": "16539ac5-0fff94e1.mp3"
 },
 {
  "key": "0909fa38",
  "who": "grandpa",
  "text": "It’s that delivery boy. The one who showed up late.",
  "exaggeration": 0.8,
  "cfg": 0.4,
  "fx": null,
  "take": "0909fa38-c48a8f07.mp3"
 },
 {
  "key": "92dd9e1a",
  "who": "grandpa",
  "text": "This is about that damn rating, isn’t it? Lucia. What did you write?",
  "exaggeration": 1.05,
  "cfg": 0.35,
  "fx": null,
  "take": "92dd9e1a-6475eebd.mp3"
 },
 {
  "key": "38bf731c",
  "who": "grandpa",
  "text": "And you listened? Since when do you listen to me?",
  "exaggeration": 0.85,
  "cfg": 0.4,
  "fx": null,
  "take": "38bf731c-9e7a10ce.mp3"
 },
 {
  "key": "c4e0bdf7",
  "who": "dad",
  "text": "Enough. Both of you.",
  "exaggeration": 0.9,
  "cfg": 0.4,
  "fx": null,
  "take": "c4e0bdf7-9148e060.mp3"
 },
 {
  "key": "1d8be92d",
  "who": "uncle",
  "text": "Just a review. Tell that to the psycho in the cheese suit.",
  "exaggeration": 0.75,
  "cfg": 0.45,
  "fx": null,
  "take": "1d8be92d-0dd13b03.mp3"
 },
 {
  "key": "62a00dbb",
  "who": "dad",
  "text": "Mija, no. This isn’t on you. Look at me. It isn’t.",
  "exaggeration": 0.85,
  "cfg": 0.35,
  "fx": "shaky",
  "take": "62a00dbb-95505653.mp3"
 },
 {
  "key": "78431376",
  "who": "grandpa",
  "text": "Nothing? Typical.",
  "exaggeration": 0.65,
  "cfg": 0.45,
  "fx": null,
  "take": "78431376-042f6085.mp3"
 },
 {
  "key": "098ef796",
  "who": "dad",
  "text": "Alex. Look at me. Whatever they bring you, you check it first. No seeds. You hear me?",
  "exaggeration": 0.9,
  "cfg": 0.35,
  "fx": null,
  "take": "098ef796-539605d8.mp3"
 },
 {
  "key": "c6a27679",
  "who": "alex",
  "text": "I know, Dad. I’m not a baby.",
  "exaggeration": 0.85,
  "cfg": 0.4,
  "fx": "shaky",
  "take": "c6a27679-76666d92.mp3"
 },
 {
  "key": "f8bf7988",
  "who": "ruben",
  "text": "Rule one: never split up. Rule two… I don’t know rule two.",
  "exaggeration": 0.95,
  "cfg": 0.4,
  "fx": "shaky",
  "take": "f8bf7988-bb11830c.mp3"
 },
 {
  "key": "c8a535f4",
  "who": "uncle",
  "text": "What about her? She doesn’t get one?",
  "exaggeration": 0.9,
  "cfg": 0.4,
  "fx": null,
  "take": "c8a535f4-164814c9.mp3"
 },
 {
  "key": "d69b1127",
  "who": "lucia",
  "text": "...One star.",
