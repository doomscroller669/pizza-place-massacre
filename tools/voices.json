  "cfg": 0.45,
  "fx": null,
  "take": "d42ae32e-629a9c39.mp3"
 },
 {
  "key": "dec2f5ab",
  "who": "manny",
  "text": "There’s a whole family in there. Kids. Balloons on the chairs. Oh God.",
  "exaggeration": 0.85,
  "cfg": 0.38,
  "fx": null,
  "take": "dec2f5ab-18413ed8.mp3"
 },
 {
  "key": "4289f36b",
  "who": "manny",
  "text": "Night Caller. “Lock every door before he calls.” No tokens, though.",
