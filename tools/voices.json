  "cfg": 0.5,
  "fx": null,
  "take": "9975ae9d-7e4031e5.mp3"
 },
 {
  "key": "f5c78376",
  "who": "manny",
  "text": "Padlocked. Someone wrote DRIVER on the tape.",
