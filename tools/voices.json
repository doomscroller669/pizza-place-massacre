  "take": "19528e5b-7e4031e5.mp3"
 },
 {
  "key": "d42ae32e",
  "who": "manny",
  "text": "He’s in there with them.",
  "exaggeration": 0.5,
  "cfg": 0.5,
  "fx": null,
  "take": "d42ae32e-7e4031e5.mp3"
 },
 {
  "key": "acee01c3",
  "who": "manny",
  "text": "A family at the party table. A little girl—no, a teenager. Balloons. God.",
  "exaggeration": 0.75,
  "cfg": 0.4,
  "fx": null,
  "take": "acee01c3-b4e9d739.mp3"
 },
 {
  "key": "4a230733",
  "who": "manny",
  "text": "NIGHT CALLER. \"Lock every door before he calls.\" No tokens.",
